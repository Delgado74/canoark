{
  "name": "canoark",
  "version": "0.2.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android --clean",
    "android:release": "expo prebuild --platform android --clean && node scripts/configure-android-signing.mjs && cd android && ./gradlew assembleRelease",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:compat": "jest --runInBand",
    "test:regtest": "jest --config jest.regtest.config.js --runInBand"
  },
  "dependencies": {
