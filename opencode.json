{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "metro-mcp": {
      "type": "local",
      "command": ["npx", "-y", "metro-mcp", "--port", "8082"],
      "cwd": ".",
      "enabled": false,
      "timeout": {
        "startup": 60000
      }
    },
    "arkade-docs": {
      "type": "remote",
      "url": "https://docs.arkadeos.com/mcp",
      "enabled": true
    }
  }
}
