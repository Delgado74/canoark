# Regtest de Arkade para la capa 2 de tests. Mismo perfil que usa Arkade Wallet.
#
# El stack es el submódulo de ts-sdk para 0.5.13 (666fccb). Fijamos las mismas
# imágenes que usa su .env.regtest: arkd 0.9.25 y emulator 0.0.9, el primero que
# no falla con arkd >= 0.9.22 al re-finalizar transacciones ya finalizadas.
ARKD_IMAGE=ghcr.io/arkade-os/arkd:v0.9.25
ARKD_WALLET_IMAGE=ghcr.io/arkade-os/arkd-wallet:v0.9.25
EMULATOR_IMAGE=ghcr.io/arkade-os/emulator:v0.0.9

# arkd >= 0.9.22 elige el scheduler según el tipo de locktime; ya no existen
# ARKD_SCHEDULER_TYPE ni ARKD_ROUND_INTERVAL.
ARKD_SESSION_DURATION=10
ARKD_LOG_LEVEL=6

# Los delays por debajo de 512 s se interpretan como bloques; mezclar unidades
# hace que arkd se niegue a arrancar. Todos pasan a segundos a la vez.
ARKD_VTXO_TREE_EXPIRY=86400
ARKD_UNILATERAL_EXIT_DELAY=3072
ARKD_PUBLIC_UNILATERAL_EXIT_DELAY=3072
ARKD_BOARDING_EXIT_DELAY=4096
ARKD_CHECKPOINT_EXIT_DELAY=2048

# El offboarding nativo paga feeSats fijos; con comisiones cero el test es
# determinista y no depende del fee rate del mempool local.
ARK_OFFCHAIN_INPUT_FEE="0.0"
ARK_ONCHAIN_INPUT_FEE="0.0"
ARK_OFFCHAIN_OUTPUT_FEE="0.0"
ARK_ONCHAIN_OUTPUT_FEE="0.0"

AUTOMINE_INTERVAL=60
